{
  "name": "sunnysideup/user-form-sealed-encryption",
  "description": "It encrypts submissions on the website that can not be unencrypted on the server without a key that never touches the server. This basically seals the submissions, but you can access them if you really need to.",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "encryption",
    "userforms",
    "user defined forms",
    "userdefinedform",
    "security",
    "sealed",
    "privacy",
    "secure"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/framework": "^6.0",
    "silverstripe/userforms": "*"
  },
  "require-dev": {
  },
  "autoload": {
    "psr-4": {
      "Sunnysideup\\UserFormSealedEncryption\\": "src/"
    }
  },
  "extra": {
    "expose": [
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "bin": [
  ],
  "authors": [
    {
      "name": "Nicolaas Thiemen Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ]
}
