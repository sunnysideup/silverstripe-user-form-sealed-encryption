{
  "name": "sunnysideup/user-form-sealed-encryption",
  "description": "It encrypts submissions on the website that can not be unencrypted on the server without a key that never touches the server. This basically seals the submissions, but you can access them if you really need to.",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "encryption",
    "userforms",
    "user defined forms",
    "userdefinedform",
    "security",
    "sealed",
    "privacy",
    "secure"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/framework": "^5.0",
    "silverstripe/admin": "^2.0"
  },
  "require-dev": {
    "sunnysideup/sswebpack_engine_only": "5.x-dev",
    "silverleague/ideannotator": "*",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7",
    "silverstripe/standards": "^1",
    "phpstan/extension-installer": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "Sunnysideup\\UserFormSealedEncryption\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "bin": [
    "bin/sake-npm-build-user-form-sealed-encryption.sh",
    "bin/sake-npm-watch-user-form-sealed-encryption.sh"
  ],
  "authors": [
    {
      "name": "Nicolaas Thiemen Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ]
}
